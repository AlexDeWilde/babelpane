<Window x:Class="BabelPane.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BabelPane"
        mc:Ignorable="d"
        Title="BabelPane"
        Width="420" Height="220"
        MinWidth="160" MinHeight="90"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Visibility="Hidden">
    <Grid>
        <!-- Border chrome: the only part that is visually opaque and mouse-hittable.
             Dragging the pane happens from here; the center stays pass-through so the
             content underneath remains visible. -->
        <Border x:Name="Chrome"
                BorderBrush="#FF3AA0FF"
                BorderThickness="2"
                Background="#0C3AA0FF"
                MouseLeftButtonDown="Chrome_MouseLeftButtonDown"
                Cursor="SizeAll">
            <Grid Background="{x:Null}" IsHitTestVisible="False">
                <TextBlock x:Name="StatusText"
                           Margin="10"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left"
                           Foreground="#FF3AA0FF"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap"
                           IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!-- Close button: mouse-only, top-right corner. -->
        <Button x:Name="CloseButton"
                Width="22" Height="22"
                Margin="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Content="x"
                FontFamily="Consolas"
                Click="CloseButton_Click"
                Cursor="Hand" />

        <!-- Resize grip: mouse-only, bottom-right corner. -->
        <Thumb x:Name="ResizeGrip"
               Width="14" Height="14"
               Margin="4"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Cursor="SizeNWSE"
               DragDelta="ResizeGrip_DragDelta"
               Background="#FF3AA0FF" />
    </Grid>
</Window>
