<Window x:Class="BabelPane.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BabelPane"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="BabelPane"
        Width="420" Height="220"
        MinWidth="160" MinHeight="90"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Topmost="True"
        Visibility="Hidden"
        KeyDown="MainWindow_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome ResizeBorderThickness="6"
                            CaptionHeight="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <!-- Border chrome: the only part that is visually opaque and mouse-hittable.
             A drag from here repositions the pane; a click (no movement) triggers
             capture+translate instead (see Chrome_MouseLeftButtonDown). The center
             stays pass-through so the content underneath remains visible while idle. -->
        <Border x:Name="Chrome"
                BorderBrush="#FF3AA0FF"
                BorderThickness="2"
                Background="#0C3AA0FF"
                MouseLeftButtonDown="Chrome_MouseLeftButtonDown"
                Cursor="SizeAll" />

        <!-- Legibility backdrop behind the translated text / busy indicator.
             Hidden while idle so the pane stays see-through for positioning. -->
        <Border x:Name="ContentBackdrop"
                Margin="4"
                Background="#CC101418"
                Visibility="Collapsed"
                IsHitTestVisible="False" />

        <!-- Translated output. FontSize is computed at runtime (see AutoFitText)
             to fill the available space rather than relying on Viewbox scaling,
             which only fits well when the text's natural aspect ratio happens
             to match the pane's. -->
        <Grid x:Name="OutputContainer" Margin="14" IsHitTestVisible="False">
            <TextBlock x:Name="OutputText"
                       Foreground="White"
                       FontFamily="Segoe UI"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Top" />
        </Grid>

        <!-- Busy indicator, shown only while a request is in flight. -->
        <StackPanel x:Name="BusyPanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <ProgressBar IsIndeterminate="True" Width="140" Height="8" />
            <TextBlock Text="Translating..."
                       Foreground="#FF3AA0FF"
                       FontFamily="Consolas"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
        </StackPanel>

        <!-- Close button: mouse-only, top-right corner. Marked hit-test-visible-in-chrome
             because it sits within WindowChrome's ResizeBorderThickness, which would
             otherwise claim clicks there for edge-resize instead of routing them here. -->
        <Button x:Name="CloseButton"
                Width="22" Height="22"
                Margin="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Content="x"
                FontFamily="Consolas"
                Click="CloseButton_Click"
                Cursor="Hand"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" />

        <!-- Copy-to-clipboard button: mouse-only, bottom-right corner. Visible
             only once a translation has successfully rendered (Triggered state). -->
        <Button x:Name="CopyButton"
                Width="52" Height="22"
                Margin="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Content="Copy"
                FontFamily="Consolas"
                Click="CopyButton_Click"
                Cursor="Hand"
                Visibility="Collapsed"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
    </Grid>
</Window>
